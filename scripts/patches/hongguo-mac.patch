+def _search_suggest(query, max_items):
+    """搜索兜底(2026-10 起 /search/tab 对客户端返回空body)。
+    联想接口 /reading/bookapi/search/suggest/v 仍可用, query_result_v2 含
+    series_id(或 keyword=剧id)、标题、封面、热度、评分、集数, 映射为与 tab 同构的结果。"""
+    j = api("GET", "/reading/bookapi/search/suggest/v", extra_query={"query": query})
+    data = j.get("data") or {}
+    items = data.get("query_result_v2") or data.get("query_result") or []
+    out, seen = [], set()
+    for it in items:
+        if not isinstance(it, dict):
+            continue
+        vd = it.get("video_data") or {}
+        if not isinstance(vd, dict):
+            vd = {}
+        sid = str(vd.get("series_id") or "")
+        if not sid:
+            kw = str(it.get("keyword") or "")
+            if it.get("word_type") == 2 and kw.isdigit():   # word_type 2=短剧; 书是 1_<hash>
+                sid = kw
+        title = re.sub("<[^>]+>", "", (it.get("name") or vd.get("title") or "")).strip()
+        if not sid or not title or sid in seen:
+            continue
+        seen.add(sid)
+        out.append({
+            "series_id": sid,
+            "title": title,
+            "episode_cnt": vd.get("episode_cnt") or 0,
+            "score": vd.get("score") or "",
+            "play_cnt": vd.get("play_cnt") or 0,
+            "hot": "" if vd else (it.get("sug_abstract") or ""),
+            "copyright": vd.get("copyright") or "",
+            "cover": vd.get("cover") or it.get("pic_url") or "",
+            "intro": (vd.get("video_desc") or it.get("sug_abstract") or "")[:60],
+            "vid": vd.get("vid") or "",
+            "duration": vd.get("duration") or 0,
+            "horiz_cover": "",
+            "cover_tags": [],
+        })
+        if len(out) >= max_items:
+            break
+    return out
 
 
