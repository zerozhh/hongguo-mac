+def _trim_cache(keep=60, min_age_s=3600):
+    """流缓存超过 keep 个时, 只清理 1 小时未动的最旧文件(追剧不再无限占盘)。"""
+    try:
+        fs = [os.path.join(STREAM_CACHE, f) for f in os.listdir(STREAM_CACHE)
+              if f.endswith(".mp4") and os.path.isfile(os.path.join(STREAM_CACHE, f))]
+        excess = len(fs) - keep
+        if excess <= 0:
+            return
+        now = time.time()
+        old = sorted((f for f in fs if now - os.path.getmtime(f) > min_age_s),
+                     key=os.path.getmtime)
+        for f in old[:excess]:
+            try:
+                os.remove(f)
+            except OSError:
+                pass
+    except OSError:
+        pass
+
+
