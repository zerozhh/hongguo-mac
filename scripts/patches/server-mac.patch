+# ---- 下一集预热: 播放中后台提前下载+解密, 切集零等待 ----
+_prefetched = set()
+_pf_lock = threading.Lock()
 
 
+@app.get("/prefetch")
+def api_prefetch(series_id: str = None, ep: str = "1", vid: str = None, quality: str = "best"):
+    """后台预热一集: 提前 下载密文+离线解密 进 .stream_cache, 接口立即返回不阻塞。
+    用法: /prefetch?series_id=xxx&ep=N (或 vid=)。重复触发自动跳过, 失败后可重试。
+    前端在当前集临近结尾时调用, 之后 /stream 命中缓存秒开。"""
+    if not vid and not series_id:
+        raise HTTPException(400, "需 series_id+ep 或 vid")
+    key = f"v:{vid}:{quality}" if vid else f"s:{series_id}:{ep}:{quality}"
+    with _pf_lock:
+        if key in _prefetched:                              # 已在预热, 幂等
+            return {"ok": True, "queued": "running"}
+        _prefetched.add(key)
+
+    def _work():
+        try:
+            v = vid
+            if not v:                                       # series_id+ep → 解析出 vid
+                meta, eps = H.get_episodes(series_id)       # 有 6h 缓存, 近乎免费
+                idx = int(ep) if str(ep).isdigit() else 1
+                t = next((e for e in eps if (e["index"] or 0) == idx), None)
+                v = t["vid"] if t else None
+            if v:
+                t0 = time.time()
+                _ensure_decrypted(v, quality)
+                print(f"[prefetch] {v}({quality}) 就绪, 耗时 {time.time()-t0:.1f}s", flush=True)
+        except Exception as e:
+            print(f"[prefetch] {key} 失败: {e}", flush=True)
+        finally:
+            with _pf_lock:
+                _prefetched.discard(key)                    # 成功后重复请求走缓存, 失败允许重试
+    threading.Thread(target=_work, daemon=True).start()
+    return {"ok": True, "queued": True}
+
